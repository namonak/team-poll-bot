{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.22/MicrosoftTeams.schema.json",
  "manifestVersion": "1.22",
  "version": "1.0.1",
  "id": "{{MICROSOFT_APP_ID}}",
  "developer": {
    "name": "Joannes",
    "websiteUrl": "https://namonak.dev",
    "privacyUrl": "https://namonak.dev/privacy",
    "termsOfUseUrl": "https://namonak.dev/terms"
  },
  "name": { "short": "투표곰", "full": "단체 대화방 투표 도우미 투표곰" },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#157AFF",
  "description": {
    "short": "@투표곰을 부르면 대화방에서 바로 투표를 만들 수 있어요 🐻",
    "full": "단체 대화방에서 @투표곰을 멘션하면 투표 만들기 카드가 열려요. 제목, 후보(2~10개), 마감 시간을 정해 투표를 시작하면 결과판에 실시간으로 표시돼요. 복수 선택과 투표 변경을 지원해요."
  },
  "bots": [{
    "botId": "{{MICROSOFT_APP_ID}}",
    "scopes": ["groupChat"],
    "supportsFiles": false,
    "isNotificationOnly": false
  }],
  "validDomains": ["poll-bot.namonak.dev"]
}
